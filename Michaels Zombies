    local data  = loadServerData()
    local entry = { JobId = game.JobId, PlaceId = game.PlaceId, Time = os.date("%H:%M | %d %b") }
    table.insert(data, 1, entry)
    if #data > 20 then table.remove(data, 21) end
    saveServerData(data)
    local _, names = buildServerList()
    savedDropdown:Refresh(names)
    selectedSave = names[1]
    notify("Server saved!")
end)

ServerSection:CreateButton("Join Saved Server", function()
    if not selectedSave or selectedSave == "None" then
        notify("No server selected!")
        return
    end
    local index = serverMap[selectedSave]
    if not index then notify("Server not found! Refresh list.") return end
    local data   = loadServerData()
    local server = data[index]
    if not server then notify("Server data missing!") return end
    if queueteleport then
        pcall(function()
            queueteleport('loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()')
        end)
    end
    notify("Joining: " .. server.Time)
    task.wait(0.3)
    TeleportService:TeleportToPlaceInstance(server.PlaceId, server.JobId, player)
end)

ServerSection:CreateButton("Refresh Server List", function()
    local data, names = buildServerList()
    savedDropdown:Refresh(names)
    if #names > 0 then selectedSave = names[1] end
    notify("Found " .. #data .. " saved servers")
end)

ServerSection:CreateButton("Clear Server History", function()
    saveServerData({})
    serverMap    = {}
    selectedSave = nil
    savedDropdown:Refresh({})
    notify("Server history cleared!")
end)

