local function teleportTo(target)
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local part
    if target:IsA("BasePart") then
        part = target
    else
        part = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
    end
    if part then
        pcall(function() hrp.CFrame = part.CFrame * CFrame.new(0, 4, 0) end)
    end
end

local function stopMod(key)
    modsActive[key] = false
    if modsConns[key] then
        modsConns[key]:Disconnect()
        modsConns[key] = nil
    end
    if modsCleanup[key] then
        pcall(modsCleanup[key])
        modsCleanup[key] = nil
    end
end

local function startMod(key, loopFn, cleanupFn)
    modsActive[key] = true
    modsConns[key]  = RunService.Heartbeat:Connect(loopFn)
    if cleanupFn then
        modsCleanup[key] = cleanupFn
    end
end

