local function loopPowerups()
    local hrp = getHRP()
    if not hrp then return end
    local ig = Workspace:FindFirstChild("Ignore")
    local folder = ig and ig:FindFirstChild("_Powerups")
    if not folder then return end
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("BasePart") then
            pcall(function() child.CFrame = hrp.CFrame end)
        elseif child:IsA("Model") then
            local root = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
            if root then pcall(function() root.CFrame = hrp.CFrame end) end
        end
    end
end

local function loopFreezeZombies()
    local ig = Workspace:FindFirstChild("Ignore")
    local folder = ig and ig:FindFirstChild("Zombies")
    if not folder then return end
    for _, zombie in ipairs(folder:GetChildren()) do
        if zombie:IsA("Model") then
            for _, part in ipairs(zombie:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.Anchored = true end)
                end
            end
        end
    end
end

local function cleanupFreezeZombies()
    local ig = Workspace:FindFirstChild("Ignore")
    local folder = ig and ig:FindFirstChild("Zombies")
    if not folder then return end
    for _, zombie in ipairs(folder:GetChildren()) do
        if zombie:IsA("Model") then
            for _, part in ipairs(zombie:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.Anchored = false end)
                end
            end
        end
    end
end

local killZombieData = {}

local function loopKillZombies()
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local unitRay   = mouse.UnitRay
    local targetPos = unitRay.Origin + unitRay.Direction * 10

    local ig = Workspace:FindFirstChild("Ignore")
    local folder = ig and ig:FindFirstChild("Zombies")
    if not folder then return end

    for _, zombie in ipairs(folder:GetChildren()) do
        if zombie:IsA("Model") then
            if not killZombieData[zombie] then
                local head = zombie:FindFirstChild("Head")
                if not (head and head:IsA("BasePart")) then continue end

                local anchored = {}
                for _, part in ipairs(zombie:GetDescendants()) do
                    if part:IsA("BasePart") and part ~= head then
                        local was = part.Anchored
                        pcall(function() part.Anchored = true end)
                        table.insert(anchored, { part = part, was = was })
                    end
                end

                local origCollide = head.CanCollide
                pcall(function()
                    head.CanCollide = false
                    head.Anchored   = true
                end)

                killZombieData[zombie] = {
                    head          = head,
                    anchoredParts = anchored,
                    origCollide   = origCollide,
                }
            end

            local data = killZombieData[zombie]
            if data and data.head and data.head.Parent then
                pcall(function()
                    data.head.CFrame     = CFrame.new(targetPos)
                    data.head.CanCollide = false
                end)
            else
                killZombieData[zombie] = nil
            end
        end
    end
end

local function cleanupKillZombies()
    for zombie, data in pairs(killZombieData) do
        if data.head and data.head.Parent then
            pcall(function()
                data.head.CanCollide = data.origCollide
                data.head.Anchored   = false
            end)
        end
        for _, entry in ipairs(data.anchoredParts) do
            if entry.part and entry.part.Parent then
                pcall(function() entry.part.Anchored = entry.was end)
            end
        end
    end
    killZombieData = {}
end

