local scanConns  = {}  -- [category] = { add, rem, folderWatch }

--══════════════════════════════════════════════════════════════
--  ESP — GET FOLDER
--══════════════════════════════════════════════════════════════

local function getFolder(category)
    if category == "MysteryBox" then
        local mc = Workspace:FindFirstChild("_MapComponents")
        return mc and mc:FindFirstChild("MysteryBox")
    elseif category == "Zombies" then
        local ig = Workspace:FindFirstChild("Ignore")
        return ig and ig:FindFirstChild("Zombies")
    elseif category == "Powerups" then
        local ig = Workspace:FindFirstChild("Ignore")
        return ig and ig:FindFirstChild("_Powerups")
    elseif category == "Parts" then
        return Workspace:FindFirstChild("_Parts")
    elseif category == "WallBuys" then
        return Workspace:FindFirstChild("_WallBuys")
    elseif category == "PerkMachines" then
        return Workspace:FindFirstChild("_PerkMachines")
    elseif category == "Players" then
        return Players
    end
    return nil
end

--══════════════════════════════════════════════════════════════
--  ESP — ADD / REMOVE
--══════════════════════════════════════════════════════════════

local function removeESP(instance)
    local data = espObjects[instance]
    if not data then return end
    pcall(function() data.highlight:Destroy() end)
    pcall(function() data.billboard:Destroy() end)
    espObjects[instance] = nil
end

local function addESP(instance, category)
    if espObjects[instance] then return end
    if not instance or not instance.Parent then return end

    local root
    if instance:IsA("Model") then
        root = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")
    elseif instance:IsA("BasePart") then
        root = instance
    else
        root = instance:FindFirstChildWhichIsA("BasePart")
    end
    if not root then return end

    local color = ESP_COLORS[category] or Color3.new(1, 1, 1)

    local hl = Instance.new("Highlight")
    hl.Adornee             = instance
    hl.FillColor           = color
    hl.OutlineColor        = color
    hl.FillTransparency    = 0.72
    hl.OutlineTransparency = 0.15
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = Workspace

    local bb = Instance.new("BillboardGui")
    bb.Adornee          = root
    bb.Size             = UDim2.new(0, 90, 0, 18)
    bb.StudsOffset      = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop      = true
    bb.ResetOnSpawn     = false
    bb.ClipsDescendants = false
    bb.Parent           = Workspace

    local lbl = Instance.new("TextLabel")
    lbl.Size                   = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                   = instance.Name
    lbl.TextColor3             = color
    lbl.TextStrokeColor3       = Color3.new(0, 0, 0)
    lbl.TextStrokeTransparency = 0.25
    lbl.Font                   = Enum.Font.Gotham
    lbl.TextSize               = 10
    lbl.TextTruncate           = Enum.TextTruncate.AtEnd
    lbl.Parent                 = bb

    espObjects[instance] = { highlight = hl, billboard = bb }

    instance.AncestryChanged:Connect(function()
        if not instance.Parent then removeESP(instance) end
    end)
end

--══════════════════════════════════════════════════════════════
--  ESP — ENABLE / DISABLE CATEGORY
--══════════════════════════════════════════════════════════════

local function enableCategory(category)
    if scanConns[category] then return end

    local folder = getFolder(category)

    local function wireFolder(f)
        -- Mystery Box: highlight the whole folder model directly
        if category == "MysteryBox" then
            if espObjects[f] then return end
            local color = ESP_COLORS.MysteryBox

            local hl = Instance.new("Highlight")
            hl.Adornee             = f
            hl.FillColor           = color
            hl.OutlineColor        = color
            hl.FillTransparency    = 0.72
            hl.OutlineTransparency = 0.15
            hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent              = Workspace

            local rootPart = nil
            for _, v in ipairs(f:GetDescendants()) do
                if v:IsA("BasePart") then rootPart = v; break end
            end
            if not rootPart and f:IsA("BasePart") then rootPart = f end

            local bb = Instance.new("BillboardGui")
            bb.Adornee      = rootPart or f
            bb.Size         = UDim2.new(0, 90, 0, 18)
            bb.StudsOffset  = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop  = true
            bb.ResetOnSpawn = false
            bb.Parent       = Workspace

            local lbl2 = Instance.new("TextLabel")
            lbl2.Size                   = UDim2.new(1, 0, 1, 0)
            lbl2.BackgroundTransparency = 1
            lbl2.Text                   = "Mystery Box"
            lbl2.TextColor3             = color
            lbl2.TextStrokeColor3       = Color3.new(0, 0, 0)
            lbl2.TextStrokeTransparency = 0.25
            lbl2.Font                   = Enum.Font.Gotham
            lbl2.TextSize               = 10
            lbl2.Parent                 = bb

            espObjects[f] = { highlight = hl, billboard = bb }

            local remConn = f.AncestryChanged:Connect(function()
                if not f.Parent then removeESP(f) end
            end)
            scanConns[category] = { rem = remConn }
            return
        end

        -- Players: ESP their character models
        if category == "Players" then
            for _, plr in ipairs(f:GetPlayers()) do
                if plr ~= player and espEnabled[category] then
                    if plr.Character then addESP(plr.Character, category) end
                end
            end

            local addConn = f.PlayerAdded:Connect(function(plr)
                if plr ~= player and espEnabled[category] then
                    local function onChar(char)
                        if espEnabled[category] then
                            task.defer(function() addESP(char, category) end)
                        end
                    end
                    if plr.Character then onChar(plr.Character) end
                    plr.CharacterAdded:Connect(onChar)
                end
            end)

            local remConn = f.PlayerRemoving:Connect(function(plr)
                if plr.Character then removeESP(plr.Character) end
            end)

            for _, plr in ipairs(f:GetPlayers()) do
                if plr ~= player then
                    plr.CharacterAdded:Connect(function(char)
                        if espEnabled[category] then
                            task.defer(function() addESP(char, category) end)
                        end
                    end)
                end
            end

            scanConns[category] = { add = addConn, rem = remConn }
            return
        end

        -- Generic folder: ESP each child
        for _, child in ipairs(f:GetChildren()) do
            if espEnabled[category] then addESP(child, category) end
        end

        local addConn = f.ChildAdded:Connect(function(child)
            if espEnabled[category] then
                task.defer(function() addESP(child, category) end)
            end
        end)

        local remConn = f.ChildRemoved:Connect(function(child)
            removeESP(child)
        end)

        scanConns[category] = { add = addConn, rem = remConn }
    end

    if folder then
        wireFolder(folder)
    else
        local watchConn
        local function checkAndWire()
            local f2 = getFolder(category)
            if f2 and espEnabled[category] then
                pcall(function() watchConn:Disconnect() end)
                wireFolder(f2)
            end
        end
        watchConn = Workspace.DescendantAdded:Connect(checkAndWire)
        scanConns[category] = { folderWatch = watchConn }
    end
end

local function disableCategory(category)
    local conns = scanConns[category]
    if conns then
        pcall(function() if conns.add         then conns.add:Disconnect()         end end)
        pcall(function() if conns.rem         then conns.rem:Disconnect()         end end)
        pcall(function() if conns.folderWatch then conns.folderWatch:Disconnect() end end)
        scanConns[category] = nil
    end

    local folder = getFolder(category)
    if folder then
        if category == "MysteryBox" then
            removeESP(folder)
        elseif category == "Players" then
            for _, plr in ipairs(folder:GetPlayers()) do
                if plr.Character then removeESP(plr.Character) end
            end
        else
            for _, child in ipairs(folder:GetChildren()) do
                removeESP(child)
            end
        end
    end

    for inst in pairs(espObjects) do
        pcall(function()
            if not inst.Parent then removeESP(inst) end
        end)
    end
end

