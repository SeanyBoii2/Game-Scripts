-- Functional toggles reset to their default after config load
-- (prevents mods from auto-running on config load)
local functionalToggles = {}

local function registerFunctionalToggle(toggle, default)
    table.insert(functionalToggles, { ref = toggle, default = default or false })
end

local function resetFunctionalToggles()
    for _, item in ipairs(functionalToggles) do
        item.ref:Set(item.default)
    end
end

