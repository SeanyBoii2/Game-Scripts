-- Helper: build a TP section with dropdown + refresh + TP button
local function buildTpSection(sectionName, description, folderFn, targetFn)
    local section = TpPage:CreateSection(sectionName)
    section:CreateLabel(description)

    local function getNames()
        local folder = folderFn()
        local names  = {}
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                table.insert(names, child.Name)
            end
        end
        return names, folder
    end

    local names, folder = getNames()
    local selected = names[1]

    local dropdown = section:CreateDropdown("Select", {
        List    = names,
        Default = names[1] or "None",
    }, function(val)
        selected = val
    end)

    section:CreateButton("Teleport", function()
        local f = folderFn()
        if not f then notify(sectionName .. " folder not found!") return end
        if not selected or selected == "None" then notify("Nothing selected!") return end

        local target = f:FindFirstChild(selected)
        if not target then notify(selected .. " not found!") return end

        local tp = targetFn and targetFn(target) or target
        teleportTo(tp)
        notify("Teleported to " .. selected)
    end)

    section:CreateButton("Refresh List", function()
        local newNames = getNames()
        dropdown:Refresh(newNames)
        selected = newNames[1]
        notify(sectionName .. " list refreshed (" .. #newNames .. " found)")
    end)

    section:CreateDivider()
end

