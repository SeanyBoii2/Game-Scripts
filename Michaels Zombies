--  TRIGGERBOT — VARIABLES & LOGIC
--══════════════════════════════════════════════════════════════

local triggerBotEnabled = false
local triggerConfig = {
    HoldClick        = true,
    TeamExclusionMode = "folder",
    MaxDistance      = nil,
    ExclusionRadius  = 5,
    AggressiveMode   = false,
}

local rightDown    = false
local lastX, lastY = 0, 0
local clickDelay   = 0
local lastClickTime = 0
local tbClicking   = false

UIS.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton2 then rightDown = true end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton2 then rightDown = false end
end)

RunService.RenderStepped:Connect(function()
    local v = UIS:GetMouseLocation()
    lastX, lastY = v.X, v.Y
end)

local function setClick(down)
    if tbClicking == down then return end
    tbClicking = down
    pcall(function() VirtualInputManager:SendMouseButtonEvent(lastX, lastY, 0, down, nil, 0) end)
end

local function spamClick()
    local now = tick()
    if now - lastClickTime < clickDelay then return end
    lastClickTime = now
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(lastX, lastY, 0, true,  nil, 0)
        VirtualInputManager:SendMouseButtonEvent(lastX, lastY, 0, false, nil, 0)
    end)
end

local function inTriggerRange(model)
    local max = triggerConfig.MaxDistance
    if not max then return true end
    local char = player.Character
    if not char then return false end
    local root1 = char:FindFirstChild("HumanoidRootPart")
    if not root1 then return false end
    local root2 = model:FindFirstChild("HumanoidRootPart")
    if not root2 then
        for _, part in ipairs(model:GetChildren()) do
            if part:IsA("BasePart") then root2 = part; break end
        end
    end
    if not root2 then return false end
    return (root1.Position - root2.Position).Magnitude <= max
end

-- Model cache for triggerbot
local modelCache = setmetatable({}, { __mode = "k" })
local function getCharacterModel(part)
    if not part then return end
    if modelCache[part] then return modelCache[part] end
    local current = part
    while current and current ~= Workspace do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            modelCache[part] = current
            return current
        end
        current = current.Parent
    end
end

-- Raycast params for triggerbot
local tbRayParams = RaycastParams.new()
tbRayParams.FilterType  = Enum.RaycastFilterType.Blacklist
tbRayParams.IgnoreWater = true

local function getTBExclusionList()
    local list = {}
    local char = player.Character
    if char then
        table.insert(list, char)
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Accoutrement") then
                table.insert(list, child)
            end
        end
    end
    return list
end

local function isPartTooClose(part)
    if not part or not part:IsA("BasePart") then return false end
    local char = player.Character
    if not char then return false end
    if part:IsDescendantOf(char) then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and (part.Position - hrp.Position).Magnitude < triggerConfig.ExclusionRadius then
        return true
    end
    return false
end

local function getTargetFromPart(hitPart)
    if not hitPart then return nil end
    if isPartTooClose(hitPart) then return nil end
    return getCharacterModel(hitPart)
end

local function getHybridTarget()
    local camera = Workspace.CurrentCamera
    if not camera then return mouse.Target and getTargetFromPart(mouse.Target) end

    tbRayParams.FilterDescendantsInstances = getTBExclusionList()
    local ray    = camera:ScreenPointToRay(lastX, lastY)
    local maxDist = triggerConfig.MaxDistance or 1000
    local result = Workspace:Raycast(ray.Origin, ray.Direction * maxDist, tbRayParams)

    if result and result.Instance then
        local model = getTargetFromPart(result.Instance)
        if model then return model end
    end
    -- Fallback to mouse.Target
    if mouse.Target then
        return getTargetFromPart(mouse.Target)
    end
    return nil
end

local function isValidTBTarget(model)
    if not model then return false end
    if model == player.Character then return false end

    if triggerConfig.AggressiveMode then
        return model:FindFirstChildOfClass("Humanoid") ~= nil
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return false end
    if not inTriggerRange(model) then return false end

    local mode = triggerConfig.TeamExclusionMode
    if mode == "team"    and isTeammate(model)               then return false end
    if mode == "folder"  and isInSameParentContainer(model)  then return false end
    if mode == "players" and Players:GetPlayerFromCharacter(model) then return false end

    return true
end

-- Triggerbot render loop
RunService.RenderStepped:Connect(function()
    if not triggerBotEnabled then
        if tbClicking then setClick(false) end
        return
    end
    if triggerConfig.HoldClick and not rightDown then
        if tbClicking then setClick(false) end
        return
    end
    local targetModel = getHybridTarget()
    if targetModel and isValidTBTarget(targetModel) then
        spamClick()
    else
        if tbClicking then setClick(false) end
    end
end)

